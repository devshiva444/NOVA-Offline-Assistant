# Example .env for NOVA offline LLM
LLM_MODEL_NAME=gemma-2-2b-it-IQ3_M.gguf
LLM_CONTEXT=2048
LLM_THREADS=4
LLM_PORT=8080
MODELS_DIR=models
LLAMA_BIN_DIR=llama\bin

# Tuning for balanced output
LOCAL_LLM_MAX_OUTPUT=6000
LOCAL_LLM_N=6000
LOCAL_LLM_TEMP=0.1
LOCAL_LLM_TOPP=0.7
LOCAL_LLM_TIMEOUT=1800

# ===== Voice Config =====
USE_WHISPER=0
WHISPER_MODEL=small
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15